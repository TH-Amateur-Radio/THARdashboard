---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:70vh;padding:2rem;text-align:center">
    <h1 style="font-size:2rem;margin:0.5rem 0">404 — 页面未找到</h1>
    <p style="color:#6b7280;margin:0.5rem 0">抱歉，无法找到您请求的页面。</p>
    <a href="/" style="margin-top:1rem;color:#fff;background:linear-gradient(83.21deg,#3245ff 0%,#bc52ee 100%);padding:0.6rem 1rem;border-radius:8px;text-decoration:none;">返回首页</a>
  </main>
</Layout>

<style>
  main h1 { font-family: Inter, Roboto, Arial, sans-serif; }
</style>
